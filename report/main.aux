\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Training and validation loss for transfer versus from-scratch. The human-initialized model (orange) decreases loss faster and reaches a lower best validation loss (0.7277 at epoch 5) than the random-initialized model (blue, 0.7403 at epoch 12). Dashed horizontal lines mark each best validation loss.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:curves}{{1}{3}{Training and validation loss for transfer versus from-scratch. The human-initialized model (orange) decreases loss faster and reaches a lower best validation loss (0.7277 at epoch 5) than the random-initialized model (blue, 0.7403 at epoch 12). Dashed horizontal lines mark each best validation loss}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Validation median AUROC per epoch for transfer (blue) versus from-scratch (orange). Transfer after one epoch matches from-scratch after about five and saturates near 0.885 within five epochs; from-scratch is still rising at epoch 10. Early stopping halts the transfer run at epoch 8.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:convergence}{{2}{3}{Validation median AUROC per epoch for transfer (blue) versus from-scratch (orange). Transfer after one epoch matches from-scratch after about five and saturates near 0.885 within five epochs; from-scratch is still rising at epoch 10. Early stopping halts the transfer run at epoch 8}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Per-feature AUROC of the transfer model on chr19. Left: distribution over 132 features, median 0.877. Right: the 15 best and 15 worst features. TF and structural targets (CTCF, RAD21, USF, POLR2A) score highest; broad histone marks score lowest.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:perfeature}{{3}{4}{Per-feature AUROC of the transfer model on chr19. Left: distribution over 132 features, median 0.877. Right: the 15 best and 15 worst features. TF and structural targets (CTCF, RAD21, USF, POLR2A) score highest; broad histone marks score lowest}{figure.3}{}}
\@writefile{toc}{\contentsline {paragraph}{The transfer gain is small but consistent across features.}{4}{section*.9}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Transfer helps every assay type; the baseline is at chance.}{4}{section*.10}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The gain concentrates on rarer features.}{4}{section*.11}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Per-feature AUROC, transfer (vertical) versus from-scratch (horizontal); points above the dashed diagonal favor transfer. Transfer wins on 115 of 133 features (median gain $+0.007$). Colors mark assay type. The single far-below-diagonal point is the rarest TF feature, where AUROC is unstable.}}{5}{figure.4}\protected@file@percent }
\newlabel{fig:paired}{{4}{5}{Per-feature AUROC, transfer (vertical) versus from-scratch (horizontal); points above the dashed diagonal favor transfer. Transfer wins on 115 of 133 features (median gain $+0.007$). Colors mark assay type. The single far-below-diagonal point is the rarest TF feature, where AUROC is unstable}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Median AUROC by assay type for the three conditions. Transfer (blue) edges out from-scratch (orange) in every assay class; the baseline (green) is at chance everywhere. DNase and TF are easiest, broad histone marks hardest.}}{5}{figure.5}\protected@file@percent }
\newlabel{fig:byassay}{{5}{5}{Median AUROC by assay type for the three conditions. Transfer (blue) edges out from-scratch (orange) in every assay class; the baseline (green) is at chance everywhere. DNase and TF are easiest, broad histone marks hardest}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Per-feature AUROC gain (transfer minus from-scratch) versus test positive rate (rarer to the left). Gains are largest for rarer features and shrink toward zero as features become common. The lone large negative is the rarest TF target from Figure~\ref {fig:paired}.}}{6}{figure.6}\protected@file@percent }
\newlabel{fig:rarity}{{6}{6}{Per-feature AUROC gain (transfer minus from-scratch) versus test positive rate (rarer to the left). Gains are largest for rarer features and shrink toward zero as features become common. The lone large negative is the rarest TF target from Figure~\ref {fig:paired}}{figure.6}{}}
